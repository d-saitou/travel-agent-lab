{
  "version": "2.0.0",
  "tasks": [
    { // VS Code 起動 (Backend 開発用 Dev Container)
      "label": "Dev Host: Open Backend Dev Container Workspace",
      "type": "shell",
      "command": "code",
      "args": ["-n", "${workspaceFolder}/backend"],
      "presentation": {"close": true},
      "problemMatcher": []
    },
    { // VS Code 起動 (Frontend 開発用 Dev Container)
      "label": "Dev Host: Open Frontend Dev Container Workspace",
      "type": "shell",
      "command": "code",
      "args": ["-n", "${workspaceFolder}/frontend"],
      "presentation": {"close": true},
      "problemMatcher": []
    },
    { // Docker Compose Up (非表示タスク：launch.json 実行・デバッグ構成用)
      "label": "Dev Host: Docker Compose Up",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d"],
      "problemMatcher": [],
      "hide": true
    },
    { // 開発コンテナ準備完了待機 (非表示タスク：launch.json 実行・デバッグ構成用)
      "label": "Internal: Wait Dev Containers Ready",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/infra/scripts/task-wait-devcontainers-ready.sh"],
      "problemMatcher": [],
      "hide": true
    },
    { // フルスタックデバッグ準備 (非表示タスク：launch.json 実行・デバッグ構成用)
      "label": "Dev Host: Prepare Full Stack Debug",
      "dependsOn": [
        "Dev Host: Docker Compose Up",
        "Internal: Wait Dev Containers Ready"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "hide": true
    },
    { // VS Code ワークスペース初回起動時セットアップ (非表示タスク：ワークスペース起動時自動実行用)
      "label": "Dev Host: Setup Workspace",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/infra/scripts/task-setup-workspace.sh"],
      "runOptions": {"runOn": "folderOpen"},
      "presentation": {"close": true},
      "problemMatcher": [],
      "hide": true
    }
  ]
}
