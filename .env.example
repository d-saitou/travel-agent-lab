#
# 環境変数定義テンプレート
# - このファイルをコピーして .env を作成し、値を設定する。
# - 環境構築完了後、このファイルは bootstrap-dev-env-wsl.ps1 により自動的に Dev Host(WSLインスタンス) にコピーされる。
#

# WSL関連設定
# - WSL_INSTANCE_NAME：作成するWSLインスタンスの名前。WSLインスタンスのホスト名にも使用するため、英数字とハイフンのみ使用可。
# - WSL_INSTANCE_PATH：WSLインスタンスの配置先 (Windows側のパス)
# - WSL_DISTRIBUTION：WSLインスタンスのベースとするディストリビューション
WSL_INSTANCE_NAME=ubuntu-for-travel-agent-lab
WSL_INSTANCE_PATH=C:\wsl\instance\ubuntu-for-travel-agent-lab
WSL_DISTRIBUTION=Ubuntu-26.04

# ホスト・コンテナ：アプリケーション用ユーザー・グループ設定
# - APP_GID：アプリケーション用グループのGID。コンテナの実行ユーザーと揃える。
# - APP_GROUP_NAME：アプリケーション用グループ名
# - APP_UID：アプリケーション用ユーザーのUID。コンテナの実行ユーザーと揃える。
# - APP_USER_NAME：アプリケーション用ユーザー名。ホームディレクトリ (/home/<ユーザー名>) の決定にも使用する。
APP_GID=9999
APP_GROUP_NAME=appgroup
APP_UID=9999
APP_USER_NAME=appuser

# ホスト・コンテナ：gitリポジトリ関連設定
# - GIT_REPO_URL：クローンするリポジトリのURL
# - GIT_REPO_NAME：クローン先のディレクトリ名 (ホームディレクトリ直下)
# - GIT_REPO_BRANCH：クローン時にチェックアウトするブランチ。HEAD指定時はリモートの既定ブランチ。
GIT_REPO_URL=https://github.com/d-saitou/travel-agent-lab.git
GIT_REPO_NAME=travel-agent-lab
GIT_REPO_BRANCH=HEAD

# ホスト：プロビジョニング用ツール設定
# - YQ_DOWNLOAD_URL：yqダウンロードURL
YQ_DOWNLOAD_URL=https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64

# コンテナ：シークレットファイル配置ディレクトリ設定
# - SECRETS_DIR：コンテナ用のシークレットファイル (DBパスワード等) の配置先
#   ※ワークスペース外のパスとする。
#   ※Ansibleのsecretsロール (roles/secrets/tasks/main.yml) の secrets_relative_path と一致させること。
SECRETS_DIR=/home/${APP_USER_NAME}/.local/share/travel-agent-lab/secrets

# コンテナ：frontend設定
# - FRONTEND_NODE_IMAGE：Node.jsのDockerイメージタグ
# - FRONTEND_APP_HOST_PORT：アプリケーションを公開するホスト側のポート (コンテナ側は3000)
# - FRONTEND_DEBUG_HOST_PORT：Node.jsデバッグ用のホスト側のポート (コンテナ側は9229)
FRONTEND_NODE_IMAGE=26-bookworm-slim
FRONTEND_APP_HOST_PORT=3000
FRONTEND_DEBUG_HOST_PORT=9229

# コンテナ：backend設定
# - BACKEND_PYTHON_IMAGE：PythonのDockerイメージタグ
# - BACKEND_UV_VERSION：コンテナ内で使用するuvのバージョン (例: 0.9.5)。latest指定時は最新版。
# - BACKEND_APP_HOST_PORT：アプリケーションを公開するホスト側のポート (コンテナ側は8000)
# - BACKEND_DEBUG_HOST_PORT：debugpyデバッグ用のホスト側のポート (コンテナ側は5678)
BACKEND_PYTHON_IMAGE=3.14-slim-trixie
BACKEND_UV_VERSION=latest
BACKEND_APP_HOST_PORT=8000
BACKEND_DEBUG_HOST_PORT=5678

# コンテナ：db設定
# - DB_PGVECTOR_IMAGE：pgvector (PostgreSQL) のDockerイメージタグ
# - DB_HOST_PORT：PostgreSQLを公開するホスト側のポート (コンテナ側は5432)
DB_PGVECTOR_IMAGE=0.8.6-pg18-trixie
DB_HOST_PORT=5432

# コンテナ：llmproxy設定
# - LLMPROXY_PYTHON_IMAGE：PythonのDockerイメージタグ
# - LLMPROXY_LITELLM_VERSION：LiteLLMのバージョン
# - LLMPROXY_HOST_PORT：LLMプロキシを公開するホスト側のポート (コンテナ側は4000)
# - LLMPROXY_PROVIDER_MODEL：利用するLLMプロバイダのモデル名 (環境に合わせて変更する)
LLMPROXY_PYTHON_IMAGE=3.14-slim-trixie
LLMPROXY_LITELLM_VERSION=1.105.0
LLMPROXY_HOST_PORT=4000
LLMPROXY_PROVIDER_MODEL=your_model
