#
# 環境変数定義テンプレート
# - このファイルをコピーして .env を作成し、値を設定する。
# - 環境構築完了後、このファイルは bootstrap-dev-env-wsl.ps1 により自動的に Dev Host(WSLインスタンス) にコピーされる。
#

# WSL関連設定
WSL_INSTANCE_NAME=ubuntu-for-travel-agent-lab
WSL_INSTANCE_PATH=C:\wsl\instance\ubuntu-for-travel-agent-lab
WSL_DISTRIBUTION=Ubuntu-24.04

# アプリケーション用ユーザー・グループ設定
APP_GID=9999
APP_GROUP_NAME=appgroup
APP_UID=9999
APP_USER_NAME=appuser
# APP_USER_PASSWORD= # .env.secretsで設定

# git関連設定
GIT_REPO_URL=https://github.com/d-saitou/travel-agent-lab.git
GIT_REPO_NAME=travel-agent-lab
GIT_REPO_BRANCH=HEAD
# GIT_USER_NAME= # .env.secretsで設定
# GIT_USER_EMAIL= # .env.secretsで設定

# yqダウンロードURL設定
YQ_DOWNLOAD_URL=https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64

# コンテナ用シークレットファイル配置ディレクトリ
SECRETS_RELATIVE_PATH=.local/share/travel-agent-lab/secrets
SECRETS_DIR=/home/${APP_USER_NAME}/${SECRETS_RELATIVE_PATH}

# frontendコンテナ設定
FRONTEND_NODE_IMAGE=26-bookworm-slim
FRONTEND_APP_HOST_PORT=3000
FRONTEND_DEBUG_HOST_PORT=9229

# backendコンテナ設定
BACKEND_PYTHON_IMAGE=3.14-slim-trixie
BACKEND_UV_VERSION=latest
BACKEND_APP_HOST_PORT=8000
BACKEND_DEBUG_HOST_PORT=5678

# DBコンテナ設定
DB_PGVECTOR_IMAGE=0.8.6-pg18-trixie
DB_HOST_PORT=5432

# LLMプロキシコンテナ設定
LLMPROXY_PYTHON_IMAGE=3.14-slim-trixie
LLMPROXY_LITELLM_VERSION=1.105.0
LLMPROXY_HOST_PORT=4000
LLMPROXY_PROVIDER_MODEL=your_model
# LLMPROXY_PROVIDER_API_KEY= # .env.secretsで設定
