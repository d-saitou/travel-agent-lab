{
  "permissions": {
    "deny": [
      "Read(/**/.env.secrets)",
      "Read(/infra/provision/ansible/group_vars/all.yml)",
      "Read(~/{{ secrets_relative_path }}/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "**/.env.secrets*",
        "infra/provision/ansible/group_vars/all.yml",
        "~/{{ secrets_relative_path }}"
      ],
      "allowRead": [
        "**/.env.secrets.example"
      ]
    }
  }
}
