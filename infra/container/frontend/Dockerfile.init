# ========================================
# Next.js プロジェクト初期化用 Dockerfile
# 以下の手順で Next.js プロジェクトを初期化する。
#
# * compose.yaml
#   frontend:
#     container_name: travel-agent-lab-frontend
#     image: travel-agent-lab-frontend:development
#     build:
#       context: ./frontend
#       dockerfile: ../infra/container/frontend/Dockerfile.init
#       args:
#         FRONTEND_NODE_VERSION: "${FRONTEND_NODE_VERSION}"
#         APP_UID: "${APP_UID}"
#         APP_GID: "${APP_GID}"
#       target: development
#     depends_on:
#       backend:
#         condition: service_healthy
#     volumes:
#       - .:/app
#
# * 実行コマンド
#   docker compose exec frontend bash
#   npx create-next-app@latest . \
#     --typescript \
#     --eslint \
#     --app \
#     --no-src-dir \
#     --import-alias "@/*" \
#     --use-npm
# ========================================

ARG FRONTEND_NODE_VERSION=26-bookworm-slim
ARG APP_UID=9999
ARG APP_GID=9999
ARG APP_USER_NAME=appuser
ARG APP_GROUP_NAME=appgroup

# ========================================
# 基礎環境構築ステージ
# ========================================
FROM node:${FRONTEND_NODE_VERSION} AS base

ARG APP_UID
ARG APP_GID
ARG APP_USER_NAME
ARG APP_GROUP_NAME

# ユーザー作成
RUN groupadd --gid ${APP_GID} ${APP_GROUP_NAME} && \
    useradd --uid ${APP_UID} --gid ${APP_GID} --create-home --shell /bin/bash ${APP_USER_NAME}

# アプリケーションディレクトリ作成
RUN mkdir -p /app/frontend && \
    chown -R ${APP_UID}:${APP_GID} /app

USER ${APP_USER_NAME}

WORKDIR /app/frontend

# ========================================
# 開発環境構築ステージ
# ========================================
FROM base AS development

USER root

# 開発用パッケージインストール
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

USER ${APP_USER_NAME}

CMD ["sleep", "infinity"]
