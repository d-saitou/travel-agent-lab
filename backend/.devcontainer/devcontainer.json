{
  "name": "Backend Dev Container",
  "dockerComposeFile": [
    "../../compose.yaml",
    "../../compose.devcontainer.yaml"
  ],
  "service": "backend",
  "remoteUser": "appuser",
  "updateRemoteUserUID": false, // Dev Container 起動時毎回匿名コンテナ作成対応
  "workspaceFolder": "/app/backend/backend.code-workspace",
  // "postStartCommand": "uv sync --frozen", // workspaceFolderがファイル指定の場合はエラー発生。dockerComposeFileのcommandで代替コマンドを実行。
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",                // Python
        "charliermarsh.ruff",              // Ruff
        "bierner.github-markdown-preview", // GitHub Markdown Preview
        "anthropic.claude-code"            // Claude Code for VS Code
      ]
    }
  }
}
