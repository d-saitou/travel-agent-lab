#
# 機密情報定義テンプレート
# - このファイルをコピーして secrets.txt を作成し、値を設定する。
# - 環境構築完了後、secrets.txt は直ちに削除すること。
#

# アプリケーション用ユーザーパスワード
APP_USER_PASSWORD=appuser_password

# gitユーザー関連設定
GIT_USER_NAME=your_name
GIT_USER_EMAIL=your_email@example.com

# LLMプロキシコンテナ接続先LLMプロバイダAPIキー
LLMPROXY_PROVIDER_API_KEY=your_api_key
