{
  "folders": [ // マルチルート・ワークスペース設定
    {
      "name": "Backend",
      "path": "backend"
    },
    {
      "name": "Frontend",
      "path": "frontend"
    },
    {
      "name": "Root",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": { // Root内ファイル・フォルダ非表示設定
      "backend/": true,        // Root/backend
      "**/.venv": true,        // Root/backend/.venv         ※名前付きボリュームマウント時空ディレクトリ作成対応
      "frontend/": true,       // Root/frontend
      "**/node_modules": true, // Root/frontend/node_modules ※名前付きボリュームマウント時空ディレクトリ作成対応
      "**/.next": true         // Root/frontend/.next        ※名前付きボリュームマウント時空ディレクトリ作成対応
    },
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false,
    "js/ts.validate.enabled": false, // js/tsエラー無効化(Node環境がfrontendコンテナ内のため)
    "python.analysis.diagnosticSeverityOverrides": {
      "reportMissingImports": "none" // インポート解決不可警告無効化(Python環境がbackendコンテナ内のため)
    },
    "[python]": { // ./backend/devcontainer.jsonの"python"セクションと一致させること
      "editor.tabSize": 4,
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "always"
      }
    },
    "[powershell]": {
      "files.encoding": "utf8bom"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-vscode-remote.vscode-remote-extensionpack", // [project(Dev Host)] Remote Development
      "ms-azuretools.vscode-docker",                  // [project(Dev Host)] Docker
      "ms-python.python",                             // [project(Dev Host) / backend(Dev Container)] Python
      "charliermarsh.ruff",                           // [project(Dev Host) / backend(Dev Container)] Ruff
      "dbaeumer.vscode-eslint",                       // [project(Dev Host) / frontend(Dev Container)] ESLint
      "esbenp.prettier-vscode",                       // [project(Dev Host) / frontend(Dev Container)] Prettier
      "bradlc.vscode-tailwindcss",                    // [project(Dev Host) / frontend(Dev Container)] Tailwind CSS IntelliSense
      "ms-vscode.js-debug-nightly"                    // [project(Dev Host) / frontend(Dev Container)] JavaScript Debugger (Nightly)
    ]
  }
}
