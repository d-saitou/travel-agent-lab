{
  "folders": [ // マルチルート・ワークスペース設定
    {
      "name": "Backend",
      "path": "backend"
    },
    {
      "name": "Frontend",
      "path": "frontend"
    },
    {
      "name": "Root",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": { // ファイル/フォルダ非表示設定
      "backend/": true,  // Root/backend  ※Root内非表示設定
      "frontend/": true  // Root/frontend ※Root内非表示設定
    },
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false,
    "[powershell]": {
      "files.encoding": "utf8bom"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-vscode-remote.vscode-remote-extensionpack", // [project(Dev Host)] Remote Development
      "ms-azuretools.vscode-docker",                  // [project(Dev Host)] Docker
    ]
  }
}
