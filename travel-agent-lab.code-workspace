{
  "folders": [ // マルチルート・ワークスペース設定
    { // Root ※先頭ディレクトリの .claude/settings.json が Claude Code によって読み込まれる
      "name": "Root",
      "path": "."
    },
    { // Backend
      "name": "Backend",
      "path": "backend"
    },
    { // Frontend
      "name": "Frontend",
      "path": "frontend"
    }
  ],
  "settings": {
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#0E2A47",
      "titleBar.activeForeground": "#FFFFFF",
      "titleBar.inactiveBackground": "#091C34",
      "titleBar.inactiveForeground": "#A7B6CC"
    },
    "files.exclude": { // Root内ファイル・フォルダ非表示設定
      "backend/": true,        // Root/backend
      "**/.venv": true,        // Root/backend/.venv         ※名前付きボリュームマウント時空ディレクトリ作成対応
      "frontend/": true,       // Root/frontend
      "**/node_modules": true, // Root/frontend/node_modules ※名前付きボリュームマウント時空ディレクトリ作成対応
      "**/.next": true         // Root/frontend/.next        ※名前付きボリュームマウント時空ディレクトリ作成対応
    },
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false,
    "js/ts.validate.enabled": false, // js/tsエラー無効化(Node環境がfrontendコンテナ内のため)
    "python.analysis.diagnosticSeverityOverrides": {
      "reportMissingImports": "none" // インポート解決不可警告無効化(Python環境がbackendコンテナ内のため)
    },
    "[python]": { // ./backend/devcontainer.jsonの"python"セクションと一致させること
      "editor.tabSize": 4,
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "always"
      }
    },
    "[powershell]": {
      "files.encoding": "utf8bom"
    }
  },
  "extensions": {
    "recommendations": [
      // "ms-vscode-remote.vscode-remote-extensionpack", // Remote Development (インストール済み前提)
      "ms-azuretools.vscode-docker",      // Docker
      "ms-python.python",                 // Python
      "charliermarsh.ruff",               // Ruff
      "ms-vscode.vscode-typescript-next", // TypeScript Next
      "ms-vscode.js-debug-nightly",       // JavaScript Debugger (Nightly)
      "dbaeumer.vscode-eslint",           // ESLint
      "esbenp.prettier-vscode",           // Prettier
      "bradlc.vscode-tailwindcss",        // Tailwind CSS IntelliSense
      "bierner.github-markdown-preview",  // GitHub Markdown Preview
      "anthropic.claude-code"             // Claude Code for VS Code
    ]
  }
}
