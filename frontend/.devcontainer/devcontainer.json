{
  "name": "Frontend Dev Container",
  "dockerComposeFile": [
    "../../compose.yaml",
    "../../compose.devcontainer.yaml"
  ],
  "service": "frontend",
  "remoteUser": "appuser",
  "updateRemoteUserUID": false, // Dev Container 起動時毎回匿名コンテナ作成対応
  "workspaceFolder": "/app/frontend/frontend.code-workspace",
  // "postStartCommand": "npm ci", // workspaceFolderがファイル指定の場合はエラー発生。dockerComposeFileのcommandで代替コマンドを実行。
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next", // TypeScript Next
        "ms-vscode.js-debug-nightly",       // JavaScript Debugger (Nightly)
        "dbaeumer.vscode-eslint",           // ESLint
        "esbenp.prettier-vscode",           // Prettier
        "bradlc.vscode-tailwindcss",        // Tailwind CSS IntelliSense
        "bierner.github-markdown-preview",  // GitHub Markdown Preview
        "anthropic.claude-code"             // Claude Code for VS Code
      ]
    }
  }
}
