{
  "permissions": {
    "deny": [
      "Read(/**/.env.secrets)",
      "Read(/infra/provision/ansible/group_vars/all.yml)",
      "Read(~/.local/share/travel-agent-lab/secrets/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "**/.env.secrets*",
        "infra/provision/ansible/group_vars/all.yml",
        "~/.local/share/travel-agent-lab/secrets"
      ],
      "allowRead": [
        "**/.env.secrets.example"
      ]
    }
  }
}
