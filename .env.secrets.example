#
# 機密情報定義テンプレート
# - このファイルをコピーして .env.secrets を作成し、値を設定する。
# - 環境構築完了後、.env.secrets は直ちに削除すること。
# - 再実行・再構築でも同じ値が必要なため、値はパスワードマネージャー等で保管すること。
#

# ホスト・コンテナ：アプリケーション用ユーザー設定
# - APP_USER_PASSWORD：アプリケーション用ユーザー (.env の APP_USER_NAME) のパスワード
APP_USER_PASSWORD=appuser_password

# ホスト・コンテナ：gitユーザー関連設定
# - GIT_USER_NAME：gitのコミット者名 (user.name)
# - GIT_USER_EMAIL：gitのコミット者メールアドレス (user.email)
GIT_USER_NAME=your_name
GIT_USER_EMAIL=your_email@example.com

# コンテナ：db設定 ※DBパスワードは英数字のみ使用可。既存のDBボリュームを再利用する場合は、そのDBの作成時と同じ値を設定すること。
# - DB_POSTGRES_USER_PASSWORD：PostgreSQL管理ユーザー (postgres) のパスワード
# - DB_APP_TX_USER_PASSWORD：トランザクション用DB (app_tx_db) の所有ユーザー (app_tx) のパスワード
# - DB_APP_RAG_USER_PASSWORD：RAG用DB (app_rag_db) の所有ユーザー (app_rag) のパスワード
DB_POSTGRES_USER_PASSWORD=db_postgres_user_password
DB_APP_TX_USER_PASSWORD=db_app_tx_user_password
DB_APP_RAG_USER_PASSWORD=db_app_rag_user_password

# コンテナ：llmproxy設定
# - LLMPROXY_PROVIDER_API_KEY：LLMプロバイダのAPIキー。接続先のモデルは .env の LLMPROXY_PROVIDER_MODEL で指定する。
LLMPROXY_PROVIDER_API_KEY=your_api_key
